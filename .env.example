# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI="mongodb://localhost:27017/serverembassy"

# Auth & Security
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
SIGNED_URL_SECRET="change-me-to-a-secure-hmac-sha256-secret-key"

# CORS — comma-separated origins
CORS_ORIGINS="https://powerlinedevices.com,https://www.powerlinedevices.com,https://powerline-admin.vercel.app,http://localhost:3000,http://localhost:5174"

# ==============================================================================
# STRIPE PAYMENT GATEWAYS (Store-Specific)
# ==============================================================================
# Power Line Devices (powerlinedevices.com)
POWERLINE_STRIPE_SECRET_KEY="sk_live_..."
POWERLINE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
POWERLINE_STRIPE_WEBHOOK_SECRET="whsec_..."

# Fallback Generic Stripe Keys (accepted by Power Line if POWERLINE_* is not set)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Server Embassy (serverembassy.com) - Optional separate keys
SERVEREMBASSY_STRIPE_SECRET_KEY="sk_live_..."
SERVEREMBASSY_STRIPE_PUBLISHABLE_KEY="pk_live_..."
SERVEREMBASSY_STRIPE_WEBHOOK_SECRET="whsec_..."

# Lucky Girl Scoops (luckygirlscoops.com) - Optional separate keys
LUCKYGIRL_STRIPE_SECRET_KEY="sk_live_..."
LUCKYGIRL_STRIPE_PUBLISHABLE_KEY="pk_live_..."
LUCKYGIRL_STRIPE_WEBHOOK_SECRET="whsec_..."


# Seed admin
ADMIN_EMAIL="admin@powerlinedevices.com"
ADMIN_PASSWORD="admin123"
AGENT_STUDIO_API_KEY="set-your-secure-random-ai-studio-api-key"

# SMTP Email Notifications
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="authorinquiry@barnesnnobel.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Power Line & Server Embassy <authorinquiry@barnesnnobel.com>"
NOTIFY_EMAIL="info@360webcoders.com,admin@serverembassy.com"
